# Copy to .env for local dev. On PythonAnywhere, set these in the WSGI file instead.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — free tier, plug-and-play API key.
# Default: Google Gemini (get a free key at https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Alternative: Groq free tier (console.groq.com -> API Keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b   # reasoning model — keep effort "low"
# LLM_API_KEY=gsk_...
# LLM_REASONING_EFFORT=low        # only needed for reasoning models; auto-retries without it

# Database — SQLite by default. For MySQL on PythonAnywhere paid tiers:
# DATABASE_URL=mysql://USER:PASSWORD@USER.mysql.pythonanywhere-services.com/USER$DBNAME
